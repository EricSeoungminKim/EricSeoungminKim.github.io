---
const { title, img, images = [], desc, url, badge, tags, target = "_blank", links = [] } = Astro.props;
import { Image } from "astro:assets";
import AutoCarousel from "./AutoCarousel.astro";
const tag_url = url && url.split("/").slice(0, -1).join("/") + "/tag";
const hasLinks = Array.isArray(links) && links.length > 0;
const hasSlides = Array.isArray(images) && images.length > 0;
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  {hasLinks ? (
    <div class="hero-content flex-col md:flex-row">
      <div class="max-w-full md:max-w-[13rem] w-full">
        {hasSlides ? (
          <AutoCarousel images={images} intervalMs={3000} />
        ) : (
          img && (
            <Image
              src={img}
              width={750}
              height={422}
              format="webp"
              alt={title}
              class="rounded-lg"
            />
          )
        )}
      </div>
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
        <div class="flex flex-wrap gap-2 py-1">
          {
            links.map((link) => (
              <a href={link.href} target="_blank" class="badge badge-secondary">
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="card-actions justify-end">
          {
            tags && tag_url &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  ) : (
    <a href={url} target={target}>
      <div class="hero-content flex-col md:flex-row">
        <div class="max-w-full md:max-w-[13rem] w-full">
          {hasSlides ? (
            <AutoCarousel images={images} intervalMs={3000} />
          ) : (
            img && (
              <Image
                src={img}
                width={750}
                height={422}
                format="webp"
                alt={title}
                class="rounded-lg"
              />
            )
          )}
        </div>
        <div class="grow w-full">
          <h1 class="text-xl font-bold">
            {title}
            {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
          </h1>
          <p class="py-1 text-1xl">{desc}</p>
          <div class="card-actions justify-end">
            {
              tags &&
                tags.map((tag) => (
                  <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                    {tag}
                  </a>
                ))
            }
          </div>
        </div>
      </div>
    </a>
  )}
</div>
